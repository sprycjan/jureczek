{
  "version": 8,
  "name": "VanVenture - Nocturnal Expedition Dark",
  "metadata": {
    "description": "Ciemny styl mapy Jureczka (v12) na bazie specyfikacji użytkownika; poprawione pola Streets v8, fonty Mapbox, dodane etykiety dróg, krajów i POI."
  },
  "sources": {
    "composite": {
      "url": "mapbox://mapbox.mapbox-streets-v8",
      "type": "vector"
    }
  },
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sprite": "mapbox://sprites/mapbox/dark-v11",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#315041" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#335b47", "fill-opacity": 0.85 }
    },
    {
      "id": "landcover-scrub",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "scrub"],
      "paint": { "fill-color": "#345e49", "fill-opacity": 0.7 }
    },
    {
      "id": "national-park",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse_overlay",
      "filter": ["==", ["get", "class"], "national_park"],
      "paint": { "fill-color": "#36654d", "fill-opacity": 0.5 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": { "fill-color": "#254a5a" }
    },
    {
      "id": "water-offset-glow",
      "type": "line",
      "source": "composite",
      "source-layer": "water",
      "paint": { "line-color": "#2e6e76", "line-width": 1.5, "line-opacity": 0.6 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#2c626c",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 3]
      }
    },
    {
      "id": "road-path-trail",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["path", "pedestrian", "track"], true, false],
      "paint": {
        "line-color": "#72b893",
        "line-width": 1.2,
        "line-dasharray": [2, 2],
        "line-opacity": 0.75
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["street", "street_limited", "service", "secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#28513d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.5, 16, 5]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["street", "street_limited", "service", "secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#445c4f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 16, 3.5]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["primary", "trunk", "motorway", "primary_link", "trunk_link", "motorway_link"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#294b36",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.5, 15, 8]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["primary", "trunk", "motorway", "primary_link", "trunk_link", "motorway_link"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#4b6d5b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 15, 5]
      }
    },
    {
      "id": "road-scenic-highlight",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": { "line-color": "#72b893", "line-width": 0.8, "line-opacity": 0.4 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "composite",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#3c5447", "fill-outline-color": "#365043" }
    },
    {
      "id": "admin-boundary",
      "type": "line",
      "source": "composite",
      "source-layer": "admin",
      "filter": ["all",
        ["!=", ["to-string", ["get", "maritime"]], "true"],
        ["<=", ["get", "admin_level"], 1]
      ],
      "paint": { "line-color": "#547363", "line-width": 1, "line-dasharray": [3, 2] }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Regular", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 9, 18, 13]
      },
      "paint": { "text-color": "#97a9a0", "text-halo-color": "#315041", "text-halo-width": 1.2 }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "poi_label",
      "minzoom": 12,
      "filter": ["<=", ["get", "filterrank"], ["step", ["zoom"], 1, 14, 2, 16, 3, 17, 5]],
      "layout": {
        "icon-image": ["coalesce", ["image", ["get", "maki"]], ["image", "marker"]],
        "icon-size": 0.9,
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": 10.5,
        "text-max-width": 8,
        "text-anchor": "top",
        "text-offset": [0, 0.9]
      },
      "paint": { "text-color": "#a5c3b1", "text-halo-color": "#315041", "text-halo-width": 1.2 }
    },
    {
      "id": "natural-point-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "natural_label",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Italic", "Arial Unicode MS Regular"],
        "text-size": 11
      },
      "paint": { "text-color": "#72b893", "text-halo-color": "#315041", "text-halo-width": 1.5 }
    },
    {
      "id": "place-label-town",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": [
        "all",
        ["match", ["get", "type"], ["suburb", "town", "village"], true, false],
        [
          "step", ["zoom"],
          ["all", ["!=", ["get", "type"], "suburb"], ["<=", ["get", "symbolrank"], 12]],
          7, ["all", ["!=", ["get", "type"], "suburb"], ["<=", ["get", "symbolrank"], 14]],
          9, ["all", ["!=", ["get", "type"], "suburb"], ["<=", ["get", "symbolrank"], 16]],
          11, true
        ]
      ],
      "layout": {
        "symbol-sort-key": ["get", "symbolrank"],
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": 11
      },
      "paint": { "text-color": "#b1c2b9", "text-halo-color": "#315041", "text-halo-width": 1.5 }
    },
    {
      "id": "place-label-city",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": [
        "all",
        ["==", ["get", "type"], "city"],
        ["<=", ["get", "symbolrank"], ["step", ["zoom"], 9, 5, 11, 7, 18]]
      ],
      "layout": {
        "symbol-sort-key": ["get", "symbolrank"],
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 10, 14, 14, 17]
      },
      "paint": { "text-color": "#f4f9f5", "text-halo-color": "#28513d", "text-halo-width": 2 }
    },
    {
      "id": "country-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "maxzoom": 8,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 14],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": { "text-color": "#8b9e94", "text-halo-color": "#28513d", "text-halo-width": 1.5 }
    }
  ]
}
