<?xml version="1.0" encoding="utf-8"?>
<!-- Tło okna pod Flutterem: neutralny zmierzch jak SplashConfig.launchSky. Okno startowe jest
     wyłączone (windowDisablePreview, v24), więc normalnie tego tła nie widać. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#7D74B4"
                android:centerColor="#B884AE"
                android:endColor="#D98E9E"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
